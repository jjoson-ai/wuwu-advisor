NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=sk_test_or_live_xxx
STRIPE_PRO_PRICE_ID=price_xxx
STRIPE_PRO_ANNUAL_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
ANTHROPIC_API_KEY=your-anthropic-api-key
# Documentation/audit flag — set to true once the org-level Zero Data Retention
# (ZDR) agreement with Anthropic is in place (requires Anthropic sales contact).
# ZDR is not activated by a per-request header; this flag signals that the
# agreement is active and surfaces a startup log confirming it. Leave false or
# unset until the agreement is signed.
ANTHROPIC_ZDR_ENABLED=false
GEOCODE_PROVIDER=opencage
OPENCAGE_API_KEY=your-opencage-api-key
FREEASTROAPI_API_KEY=your-freeastroapi-api-key
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_COMPLETED_LABEL=signup_label
NEXT_PUBLIC_GOOGLE_ADS_ONBOARDING_COMPLETED_LABEL=onboarding_label
NEXT_PUBLIC_GOOGLE_ADS_FIRST_ASK_SUBMITTED_LABEL=first_ask_label
NEXT_PUBLIC_GOOGLE_ADS_CHECKOUT_STARTED_LABEL=checkout_label
NEXT_PUBLIC_GOOGLE_ADS_PRO_ACTIVATED_LABEL=purchase_label
META_PIXEL_ID=123456789012345
# Client-visible copy of META_PIXEL_ID so the browser can load fbevents.js
# (NEXT_PUBLIC_ vars are inlined into the client bundle). Must equal
# META_PIXEL_ID — they're the same pixel, dual-exposed for client + server.
NEXT_PUBLIC_META_PIXEL_ID=123456789012345
META_CONVERSIONS_API_ACCESS_TOKEN=meta_access_token
PAID_MEDIA_PRO_VALUE_USD=14.99
# OpenAI API key for text-embedding-3-small (memory feature 5.1a).
# Used only for generating and querying vector embeddings in the Ask memory
# pipeline. If unset, fact extraction still runs but facts will not be
# retrievable by similarity search until the key is set.
OPENAI_API_KEY=your-openai-api-key
# Memory pipeline feature flags.
# MEMORY_EXTRACTION_ENABLED: set to "true" to start building the fact corpus.
#   Facts are extracted fire-and-forget after each Ask turn and stored in
#   user_facts. No user-visible change when injection is off.
# MEMORY_INJECTION_ENABLED: set to "true" to inject retrieved facts into Ask
#   prompts. Only enable after verifying extraction quality for ~5 days.
MEMORY_EXTRACTION_ENABLED=false
MEMORY_INJECTION_ENABLED=false
# Ops dashboard password — a long random string known only to the operator.
# The /ops route tree is gated behind this; no Supabase account needed.
# Generate one with: openssl rand -hex 32
OPS_SECRET=change-me-use-openssl-rand-hex-32

# Sentry (Gate 1.3, 2026-05-05)
# Set these in Vercel. Leave empty in .env.local.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Resend email provider (Gate 1.5, 2026-05-05) — API key and webhook secret
# from resend.com dashboard. EMAIL_FROM must be a verified sender address on
# your Resend domain.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=

# Ad-spend ingestion (Gate 2.7, 2026-05-06)
# Required for pulling daily cost data from Meta Ads API into the /ops dashboard.
# META_ADS_ACCESS_TOKEN is a system-user token with ads_read scope.
# META_ADS_ACCOUNT_ID is the ad account ID (e.g. act_1234567890).
# When unset, the dashboard falls back to mock data (source='mock' rows).
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=
# Required for pulling daily cost data from Google Ads API.
# GOOGLE_ADS_DEVELOPER_TOKEN: from the Google Ads API center.
# GOOGLE_ADS_CUSTOMER_ID: the customer account ID (without dashes).
# When these are unset, the dashboard falls back to mock data.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
