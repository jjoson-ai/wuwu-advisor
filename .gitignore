# Dependencies
node_modules/
.expo/

# Next.js build output
.next/
out/

# Environment secrets — never commit these
.env.local
.env.*.local
apps/mobile/.env

# macOS
.DS_Store
**/.DS_Store

# Claude Code local settings + ephemeral session state
# Keeps versioned .claude/ entries (e.g. settings.json, plugin/skill configs)
# but excludes anything per-machine or generated by a running session.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/projects/
.claude/worktrees/
.claude/cache/
.claude/logs/

# TypeScript build info
tsconfig.tsbuildinfo
apps/mobile/tsconfig.tsbuildinfo

# Python cache
__pycache__/
*.pyc

# Test/CI artifacts
playwright/.auth/
playwright-report/
test-results/
audit-artifacts/

# Bakeoff outputs
bakeoff/outputs/
bakeoff/judgments/
bakeoff/reports/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
